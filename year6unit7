 w.innerHTML='<h1>Teacher\'s notes</h1><h2>Learning outcomes</h2><table><tr><th>Module</th><th>Outcome</th></tr><tr><td>Reading</td><td><b>Identify</b> features of an interview and a song.</td></tr><tr><td>Listening</td><td><b>Match</b> songs and music pieces to moods.</td></tr><tr><td>Speaking</td><td><b>Present</b> a short talk about a favourite song.</td></tr><tr><td>Writing</td><td><b>Compose</b> a new rhyming verse.</td></tr><tr><td>Grammar</td><td><b>Construct</b> sentences with will and going to, and <b>state</b> future times using the present simple.</td></tr></table>'+
 '<h2>Embedded assessment</h2><p>Each module ends with a checkpoint. A correct answer gets a red-pen tick and praise. A wrong answer gets a hint and a retry. A second wrong answer shows a sticky-note mini-lesson. The final quiz gives a score.</p>'+
 '<h2>Learning flow in every module</h2><table><tr><th>Phase</th><th>In this courseware</th></tr><tr><td>1. Activate</td><td>A warm-up poll or question at the start of each module.</td></tr><tr><td>2. Present</td><td>Illustrated texts, audio with captions, vocabulary and a short grammar explainer.</td></tr><tr><td>3. Practise</td><td>Sorting, matching, sentence builders, a lyric builder and quizzes.</td></tr><tr><td>4. Feedback</td><td>Automatic ticks, hints, retries and mini-lessons. Teacher comments and peer responses happen outside this page, for example through your school platform.</td></tr><tr><td>5. Reflect</td><td>Two short questions and a feeling check.</td></tr></table>'+
 '<h2>Videos on the home page</h2><ul><li>The page shows one video of a song and one video of an interview, so pupils can hear and see the difference before they start the modules.</li><li>To change a video, open the file in a text editor and paste your own YouTube link at the very top, where it says PUT YOUR YOUTUBE LINKS HERE.</li><li>Watch both videos yourself before sharing the page. Videos need an internet connection, and some school networks block YouTube.</li></ul><h2>Setting up</h2><ul><li><b>Sounds:</b> buttons make small sounds, made by the page. The Sound button at the bottom turns them off. The tunes in the Listening module are not affected.</li><li><b>Welcome screen:</b> the page opens with a welcome message. Pupils press the button to open the full website. The Unit 7 button at the top always brings them back to the home page.</li><li><b>Audio:</b> the tunes are made by the page. To use your own royalty-free audio, replace the Play buttons with &lt;audio controls src="..."&gt; tags and credit the source.</li><li><b>Microphone:</b> some embedded pages block the microphone. If so, students can use a phone voice recorder and continue with the checklist.</li><li><b>Progress</b> is kept only while the page is open. Nothing is stored or sent anywhere.</li></ul>';
 return w;
}

var VIEWS={welcome:welcomeView,home:home,final:finalView,safe:safeView,teacher:teacherView,R:readingView,L:listeningView,W:writingView,S:speakingView};
function go(v){var b=$('.book');if(b)b.classList.toggle('welcome',v==='welcome');show(VIEWS[v]())}

$('#homeBtn').onclick=function(){go('home')};
$('#fSafe').onclick=function(){go('safe')};
$('#fTeach').onclick=function(){go('teacher')};
$('#fSound').onclick=function(){sfxOn=!sfxOn;this.textContent=sfxOn?'Sound on':'Sound off';this.setAttribute('aria-pressed',String(sfxOn));say(sfxOn?'Sound is on.':'Sound is off.');if(sfxOn)sfx('click')};
document.addEventListener('click',function(e){
 var t=e.target.closest('button,.w');
 if(!t||t.disabled)return;
 if(t.matches('.opt,.chk,.play,.mini,[data-nosound],#fSound'))return;
 if(t.matches('.row-btn,.tab,.nx,.bk,.unitbtn,.cta,#fSafe,#fTeach,.btn.big'))sfx('nav');
 else if(t.matches('.chip,.blank,.w'))sfx('pick');
 else sfx('click');
});
document.addEventListener('change',function(e){if(e.target.matches('select'))sfx('pick')});
go('welcome');
})();
</script>
</body>
</html>
