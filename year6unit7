<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;700;800&family=Patrick+Hand&display=swap" rel="stylesheet">
<style>
:root{--ink:#1B365D;--edge:#5B7FAE;--desk:#C9DBEF;--paper:#EEF4FB;--card:#F8FBFE;--rule:#D3E2F3;--pen:#B8342B;--pencil:#4A5F7D;--muted:#46597A;--note:#FFF3C4;--hl:#FFE59A;--t:#E1ECF8;--hero:#2C5A99;--mint:#A8EBD0;--cta:#C4501A;
--R:#2A64B5;--RL:#DCE9F8;--L:#0F7C78;--LL:#D6EFEC;--S:#B5521A;--SL:#F8E6D6;--W:#6552B8;--WL:#E6E2F6;
--hand:"Patrick Hand","Segoe Print","Bradley Hand","Comic Sans MS",cursive}
*{box-sizing:border-box}
html{font-size:18px}
body{margin:0;background:var(--desk);color:var(--ink);font-family:Lexend,system-ui,"Segoe UI",sans-serif;line-height:1.7}
button{font:inherit;cursor:pointer;color:inherit}
:focus-visible{outline:3px solid #000;outline-offset:2px;box-shadow:0 0 0 6px var(--hl)}
main:focus,main:focus-visible{outline:none;box-shadow:none}
.sr{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.c-R{--m:var(--R);--t:var(--RL)}.c-L{--m:var(--L);--t:var(--LL)}.c-S{--m:var(--S);--t:var(--SL)}.c-W{--m:var(--W);--t:var(--WL)}.c-F{--m:var(--ink);--t:#EEF1F6}
.ic{width:1.3em;height:1.3em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;vertical-align:-.25em;flex:none}

/* page frame: header with Unit 7, content, footer */
.book{max-width:1000px;margin:1rem auto;background:var(--paper);border:2px solid var(--edge);border-left:14px solid var(--hero);border-radius:18px}
.top{position:sticky;top:0;z-index:5;background:var(--hero);color:#fff;padding:.5rem 1.4rem;border-radius:0 16px 0 0}
.unitbtn{background:none;border:0;padding:.1rem .35rem;margin-left:-.35rem;font-size:1.5rem;font-weight:800;display:inline-flex;align-items:center;gap:.5rem;border-radius:10px;color:#fff}
.unitbtn:hover{text-decoration:underline;text-decoration-thickness:2px}
footer{border-top:2px solid var(--edge);padding:.7rem 1.4rem;display:flex;flex-wrap:wrap;gap:.3rem 1.8rem;background:#DCE8F6;border-radius:0 0 16px 0}
footer button{background:none;border:0;padding:.1rem 0;font-weight:500;text-decoration:underline;color:var(--ink)}

/* the exercise-book page */
main{padding:1.2rem 1.6rem 2rem;outline:none;min-height:60vh}
@media (max-width:640px){.route li{font-size:.6rem;letter-spacing:-.02em;padding-right:.15rem}.book{margin:.5rem;border-left-width:10px}.top{padding:.4rem 1rem}main{padding:1rem 1rem 1.5rem}footer{padding:.6rem 1rem}}
h1{font-size:clamp(2.1rem,6.5vw,3.5rem);line-height:1.05;letter-spacing:-.02em;margin:0;font-weight:700}
h2{font-size:1.5rem;line-height:1.25;margin:1.8rem 0 .4rem;font-weight:700}
h3{font-size:1.2rem;line-height:1.3;margin:.3rem 0 .4rem;font-weight:700}
h4{font-size:1rem;margin:1.2rem 0 .3rem;font-weight:700}
p{margin:.5rem 0}
.lead{font-size:1.15rem;max-width:34rem}
.muted{color:var(--muted);font-size:.9rem}
.hand{font-family:var(--hand);font-size:1.35rem;line-height:1.35}

/* the five-step learning route */
.route{list-style:none;display:flex;margin:1rem 0 .6rem;padding:0;max-width:34rem}
.route li{flex:1;position:relative;padding-top:1.35rem;font-size:.8rem;font-weight:500;color:var(--muted);line-height:1.3}
.route li::before{content:"";position:absolute;top:.15rem;left:0;width:.85rem;height:.85rem;border-radius:50%;border:2px solid var(--edge);background:var(--card);z-index:1}
.route li::after{content:"";position:absolute;top:.5rem;left:.85rem;right:0;height:2px;background:var(--ink)}
.route li:last-child::after{display:none}
.route li.past::before{background:var(--ink)}
.route li.on{color:var(--ink);font-weight:700}
.route li.on::before{background:var(--m,var(--ink));transform:scale(1.25)}

/* sheets, contents list */
.sheet{background:var(--card);border:2px solid var(--edge);border-top:6px solid var(--m,var(--ink));border-radius:10px;padding:.8rem 1.2rem 1rem;margin:1.2rem 0}
.sheet h2{margin-top:.2rem}
.chips{display:flex;flex-wrap:wrap;gap:.5rem;margin:.5rem 0}
.chip{background:var(--card);border:2px solid var(--edge);border-radius:10px;padding:.25rem .95rem;font-weight:500;color:var(--ink)}
.chip.sel{background:var(--hl)}
.chip.bad{border-style:dashed;border-color:var(--pen);color:var(--pen)}
.seg{display:flex;gap:5px;max-width:18rem;margin:.4rem 0 .2rem}
.seg i{flex:1;height:12px;border:2px solid var(--edge);border-radius:2px;background:var(--card)}
.seg i.d{background:var(--m)}
.toc{list-style:none;padding:0;margin:.6rem 0}
.row-btn{display:grid;grid-template-columns:2.4rem 1fr auto;grid-template-areas:"no nm st" "no ds st";gap:0 .9rem;width:100%;text-align:left;background:var(--card);border:2px solid var(--edge);border-left:14px solid var(--m);border-radius:10px;padding:.65rem 1rem;margin:.6rem 0;color:var(--ink)}
.row-btn:hover{background:var(--t)}
.row-btn .no{grid-area:no;font-size:2rem;line-height:1.2;font-weight:700;color:var(--m)}
.row-btn .no .ic{width:1.8rem;height:1.8rem}
.row-btn .nm{grid-area:nm;font-size:1.25rem;font-weight:700;line-height:1.3}
.row-btn .nm .ic{color:var(--m);margin-right:.35rem}
.row-btn .ds{grid-area:ds;color:var(--muted);font-size:.88rem;line-height:1.4}
.row-btn .stat{grid-area:st;align-self:center;font-family:var(--hand);font-size:1.3rem;color:var(--pen)}
.row-btn.fin{background:var(--note)}
.row-btn.fin:hover{background:#FFE770}

/* chapter heading, folder tabs, page */
.chap{display:flex;align-items:center;gap:.7rem;background:var(--m);color:#fff;padding:.5rem 1rem;border-radius:10px}
.chap h2{margin:0;color:#fff}
.chap .ic{width:1.8rem;height:1.8rem}
.steps{display:flex;flex-wrap:wrap;gap:.25rem;margin:1rem 0 0;border-bottom:2px solid var(--edge)}
.tab{background:var(--card);border:2px solid var(--edge);border-bottom:0;border-radius:10px 10px 0 0;padding:.2rem .75rem;font-size:.8rem;font-weight:500;margin-bottom:-2px;color:var(--ink)}
.tab.past{background:var(--t)}
.tab[aria-current="step"]{background:var(--m);border-color:var(--m);color:#fff;font-weight:700}
.page{background:var(--card);border:2px solid var(--edge);border-top:0;padding:.8rem 1.2rem 1.5rem;margin-bottom:1rem}
.nav{display:flex;justify-content:space-between}
.btn{background:var(--m,var(--ink));color:#fff;border:2px solid var(--m,var(--ink));border-radius:10px;padding:.45rem 1.1rem;font-weight:700;margin:.2rem .35rem .2rem 0}
.btn:hover:not(:disabled){filter:brightness(.82)}
.btn.ghost{background:var(--card);color:var(--ink);border-color:var(--ink)}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn.big{padding:.6rem 1.4rem;font-size:1.05rem}
.mini{background:var(--card);border:2px solid var(--edge);border-radius:10px;padding:0 .6rem;font-size:.8rem;font-weight:500;margin-left:.3rem}

/* questions */
.qno{margin:0;font-size:.85rem;font-weight:700;color:var(--m)}
.ticks{display:flex;gap:5px;margin:.3rem 0 .8rem}
.ticks i{flex:1;height:8px;border:2px solid var(--edge);border-radius:2px;background:var(--card)}
.ticks i.f{background:var(--m,var(--ink))}.ticks i.c{background:var(--hl)}
.q{font-size:1.2rem;margin:.2rem 0 .7rem}
.opts{counter-reset:o;display:grid;gap:.45rem}
.opt{text-align:left;background:var(--card);border:2px solid var(--edge);border-radius:10px;padding:.45rem .9rem;font-weight:500}
.opt::before{counter-increment:o;content:counter(o,lower-alpha) ")";font-weight:700;margin-right:.7rem;color:var(--m)}
.opt:hover:not(:disabled){background:var(--t)}
.opt.ok{background:#D6EFEC;border-color:#0F7C78}
.opt.no{border-style:dashed;border-color:#7A8394;color:var(--muted);text-decoration:line-through}

/* feedback written like a teacher's marking */
.fb{margin-top:.7rem}
.fb.good{display:flex;align-items:center;gap:.5rem;font-family:var(--hand);font-size:1.6rem;color:var(--pen);line-height:1.2}
.fb.good .ic{stroke:var(--pen);stroke-width:3;width:1.8rem;height:1.8rem}
.fb.hint{font-family:var(--hand);font-size:1.35rem;line-height:1.35;color:var(--pencil);border-left:3px solid #7A8394;padding:.1rem .9rem}
.fb.remedial{background:var(--note);font-family:var(--hand);font-size:1.3rem;line-height:1.35;padding:.7rem 1rem;border-radius:2px;transform:rotate(-.4deg);margin-top:.9rem}
.stamp{display:inline-grid;place-items:center;border:3px solid var(--pen);color:var(--pen);border-radius:50%;width:5.4rem;height:5.4rem;font-family:var(--hand);font-size:1.7rem;transform:rotate(-8deg);margin:.2rem 0 .4rem}
.done{text-align:left}

/* reading */
.qq{margin:.9rem 0 .1rem;font-weight:700}
.qtag{display:inline-block;background:var(--m);color:#fff;border-radius:2px;padding:0 .5rem;margin-right:.55rem;font-size:.85rem}
.aa{margin:.1rem 0 .4rem 2.1rem}
.lyrics{background:var(--card);border:2px solid var(--edge);border-radius:10px;padding:.4rem 1.1rem .8rem;max-width:30rem}
.lyrics .lab{display:block;font-size:.85rem;font-weight:700;color:var(--m);margin-top:.7rem}
.lyrics .ch{margin-left:.8rem;padding-left:.9rem;border-left:3px solid var(--m)}
.w{cursor:pointer;border-radius:3px;padding:0 1px}
.w:hover{background:var(--t)}
.w.hl{background:var(--hl);font-weight:700}

.vocab .vrow{display:grid;grid-template-columns:4.2rem 1fr auto;grid-template-areas:"p w b" ". m m";gap:.1rem .9rem;align-items:center;border-bottom:1px dotted var(--pencil);padding:.55rem 0}
.vp{grid-area:p}.vrow b{grid-area:w;color:var(--m);font-size:1.05rem}.vrow .vm{grid-area:m;font-size:.9rem}.vrow .vb{grid-area:b}
@media (max-width:420px){.vocab .vrow{grid-template-columns:3.4rem 1fr;grid-template-areas:"p w" "p b" ". m"}}
.pic{width:3.6rem;height:3.6rem;fill:none;stroke:var(--m,var(--ink));stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;flex:none;display:block}
.pic .f{fill:var(--t,#E1ECF8)}
.chip svg.pic{width:2.2rem;height:2.2rem;margin-right:.5rem}
.chip.hasp{display:inline-flex;align-items:center;padding:.2rem .95rem .2rem .5rem}
.ideas{display:flex;flex-wrap:wrap;gap:.9rem 1.4rem;margin:.4rem 0 .8rem}
.ideas figure{margin:0;text-align:center;font-size:.85rem;font-weight:500}
.ideas figure svg.pic{margin:0 auto .1rem}

/* games */
.pool{display:flex;flex-wrap:wrap;gap:.5rem;min-height:3.2rem;background:#E4EEF9;border:2px solid var(--edge);border-radius:10px;padding:.6rem;margin:.6rem 0}
.bins{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:.8rem}
.bin{background:var(--t);border:2px dashed var(--m);border-radius:10px;padding:.4rem .7rem .6rem;min-height:7rem}
.bin h4{margin:.1rem 0 .4rem;color:var(--m)}
.bin .chip{margin:.15rem}
.verse{background:var(--card);border:2px solid var(--edge);border-radius:10px;padding:.4rem 1.1rem;margin:.6rem 0;font-family:var(--hand);font-size:1.45rem;line-height:1.4}
.verse p{margin:.35rem 0}
.blank{min-width:5.5rem;border:0;border-bottom:2px solid var(--m);background:transparent;font-family:var(--hand);font-size:inherit;color:var(--pen);text-align:center;padding:0 .4rem}
.row{display:flex;flex-wrap:wrap;gap:.4rem .8rem;align-items:center;margin:.4rem 0}
.row label{min-width:11rem;font-weight:500}
textarea,select,input[type=time]{font-family:inherit;font-size:1rem;border:2px solid var(--edge);border-radius:10px;padding:.3rem .6rem;color:var(--ink);background:var(--card)}
textarea{width:100%;font-family:var(--hand);font-size:1.3rem;line-height:1.35}
.out{background:var(--card);border-left:4px solid var(--m,var(--ink));padding:.4rem 1rem;font-family:var(--hand);font-size:1.4rem;line-height:1.4;margin-top:.7rem}
.pre{white-space:pre-wrap}
.clip{display:grid;grid-template-columns:6.5rem auto 1fr;gap:.2rem .9rem;align-items:center;border-bottom:1px dotted var(--pencil);padding:.5rem 0}
.clip b{font-size:1.05rem}
@media (max-width:640px){.clip{grid-template-columns:1fr auto}.clip .muted{grid-column:1/-1}}
.ex{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem;margin:.6rem 0 1rem}
.ex div{border-top:3px solid var(--m);padding-top:.4rem}
.ex .ic{width:2.3rem;height:2.3rem;color:var(--m)}
.ex .k{display:block;font-weight:700;color:var(--m);font-size:.9rem;line-height:1.3}
.ex .s{font-family:var(--hand);font-size:1.45rem;line-height:1.3}
mark{background:var(--hl);color:var(--ink);padding:0 .2rem}
.ck label{display:block;margin:.4rem 0;font-weight:500}
.ck input{width:1.15rem;height:1.15rem;margin-right:.6rem;accent-color:var(--m)}
.cert{background:var(--card);border:5px double var(--ink);padding:1.2rem 1.5rem;text-align:left;margin:.6rem 0}
.cert h2{font-size:2.2rem;margin:.2rem 0}
table{border-collapse:collapse;width:100%;background:var(--card);margin:.5rem 0}
td,th{border:2px solid var(--edge);padding:.35rem .6rem;text-align:left;vertical-align:top;font-size:.92rem}
ul{padding-left:1.2rem}
/* hero */
.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:1rem;align-items:center;background:var(--hero);color:#fff;border-radius:18px;padding:1.5rem 1.7rem 1.3rem;margin-bottom:1.1rem}
.hero h1{color:var(--mint);font-size:clamp(2.4rem,7vw,3.9rem);line-height:1;font-weight:800;letter-spacing:-.02em}
.hero .lead{color:#fff;margin:.9rem 0 .7rem}
.hero .bars{display:block;height:2px;background:rgba(255,255,255,.65);width:12rem;max-width:100%;margin:.5rem 0}
.hero .bars+.bars{width:5rem;margin-top:0}
.cta{background:var(--cta);color:#fff;border:0;border-radius:6px;padding:.6rem 1.4rem;font-weight:700;font-size:1.05rem;margin-top:.5rem}
.cta:hover{filter:brightness(.9)}
.hero .art{max-width:400px;justify-self:end}
.vid a{color:var(--m);font-weight:700}
@media (max-width:640px){.hero{grid-template-columns:1fr;padding:1.2rem}.hero .art{max-width:270px;justify-self:center}}
/* gentle movement */
.art .a-head,.art .a-arm,.art .a-note,.art .a-bub,.art .a-rec,.art .a-tone{transform-box:fill-box}
.a-head{transform-origin:50% 100%;animation:headbob 3.4s ease-in-out infinite}
.a-head.d2{animation-delay:-1.7s}
.a-arm{transform-origin:50% 100%;animation:armsway 2.6s ease-in-out infinite}
.a-note{animation:notefloat 2.8s ease-in-out infinite}
.a-note.n2{animation-delay:-1.4s}
.a-bub{transform-origin:50% 100%;animation:bubpop 3s ease-in-out infinite}
.a-bub.b2{animation-delay:-1.5s}
.a-rec{transform-origin:50% 50%;animation:spin 5s linear infinite}
.a-tone{transform-origin:85% 10%;animation:tonesway 4s ease-in-out infinite}
.pic{transform-origin:50% 50%;animation:picfloat 3.6s ease-in-out infinite}
.pic.p-day{animation:spin 16s linear infinite}
.pic.p-beat{animation:heartbeat 1.2s ease-in-out infinite}
.pic.p-play{animation:ballbounce 1.5s ease-in-out infinite}
.ex .ic{animation:picfloat 3.2s ease-in-out infinite}
@keyframes headbob{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-2px) rotate(2.5deg)}}
@keyframes armsway{0%,100%{transform:rotate(0)}50%{transform:rotate(-5deg)}}
@keyframes notefloat{0%,100%{transform:translateY(0);opacity:1}50%{transform:translateY(-7px);opacity:.65}}
@keyframes bubpop{0%,100%{transform:scale(1)}50%{transform:scale(1.07)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes tonesway{0%,100%{transform:rotate(0)}50%{transform:rotate(-3deg)}}
@keyframes picfloat{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-3px) rotate(2deg)}}
@keyframes heartbeat{0%,100%{transform:scale(1)}15%{transform:scale(1.1)}30%{transform:scale(1)}45%{transform:scale(1.07)}}
@keyframes ballbounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
/* meet the teacher */
.book.welcome main{display:block;min-height:0}
.welc{width:100%}
.hero.big{padding:2rem 1.7rem}
.meet{display:grid;grid-template-columns:auto 1fr;gap:1.8rem;align-items:center;background:var(--card);border:2px solid var(--edge);border-radius:18px;padding:1.6rem 1.8rem;margin:1.2rem 0}
.meet-photo{position:relative;width:14rem}
.meet-photo img{display:block;width:100%;height:auto;border-radius:16px;border:4px solid var(--hero);box-shadow:8px 8px 0 #A8EBD0;background:#fff}
.deco{position:absolute;width:3rem;height:3rem;color:var(--cta)}
.deco.d1{top:-1.3rem;right:-1.4rem}
.deco.d2{bottom:-1.1rem;left:-1.3rem;width:2.4rem;height:2.4rem;color:#0F7C78}
.deco .a-note{transform-box:fill-box}
.meet h2{margin:0;font-size:clamp(1.8rem,5vw,2.6rem);line-height:1.1;font-weight:800;color:var(--ink)}
.staff{display:block;width:14rem;max-width:100%;height:1.5rem;margin:.4rem 0 .6rem}
.facts{list-style:none;margin:.4rem 0 0;padding:0;display:grid;gap:.6rem}
.facts li{display:grid;grid-template-columns:2.5rem 1fr;gap:.8rem;align-items:center}
.facts .fi{width:2.5rem;height:2.5rem;border-radius:50%;background:var(--t);color:var(--hero);display:grid;place-items:center}
.facts .fi .ic{width:1.35rem;height:1.35rem}
.facts .fl{display:block;font-size:.8rem;color:var(--muted);line-height:1.3}
.facts .fv{display:block;font-weight:700;line-height:1.35}
.go{text-align:center;margin:1.6rem 0 .6rem}
.cta.big{font-size:1.15rem;padding:.8rem 1.8rem}
@media (max-width:700px){.meet{grid-template-columns:1fr;padding:1.4rem 1.1rem;gap:1.6rem;justify-items:center}.meet-photo{width:min(12rem,70%)}.meet-info{width:100%}}
.who{display:flex;align-items:center;gap:.9rem;margin:1.6rem 0 .2rem;color:var(--hero);font-weight:700;font-size:1.05rem;letter-spacing:.02em}
.who::before,.who::after{content:"";flex:1;height:2px;background:linear-gradient(90deg,transparent,var(--edge));border-radius:2px}
.who::after{background:linear-gradient(270deg,transparent,var(--edge))}
.who span{display:inline-flex;align-items:center;gap:.5rem;text-align:center}
.who .deco{position:static;width:1.5rem;height:1.5rem;flex:none}
/* welcome screen */
.book.welcome .top,.book.welcome footer{display:none}
.hero.big{grid-template-columns:1fr;text-align:center;padding:2.6rem 1.7rem}
.hero.big h1{font-size:clamp(2rem,6vw,3.3rem);line-height:1.1}
.hero.big .bars,.hero.big .lead{margin-left:auto;margin-right:auto}
/* art */
.art{display:block;width:100%;height:auto}
.withart{display:flex;flex-wrap:wrap;gap:.6rem 1.2rem;align-items:center;margin:.4rem 0}
.artcol{flex:none;width:11rem;max-width:100%}
.artcol.wide{width:15rem}
/* videos */
.watch{margin:1.4rem 0}
.vids{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:1.2rem;margin:.8rem 0}
.vid{background:var(--card);border:2px solid var(--edge);border-top:6px solid var(--m);border-radius:14px;padding:.8rem 1rem 1rem}
.vid header{display:flex;align-items:center;gap:.8rem}
.vid header .art{width:5rem;flex:none}
.vid h3{margin:0;color:var(--m);font-size:1.3rem}
.frame{position:relative;aspect-ratio:16/9;background:#BFD3EA;border-radius:10px;overflow:hidden;margin:.7rem 0}
.frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.frame .empty{display:grid;place-items:center;height:100%;padding:1rem;text-align:center;color:var(--ink)}
.thumb{position:relative;display:block;width:100%;height:100%;background:#BFD3EA}
